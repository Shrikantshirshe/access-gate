pragma language_version >= 0.22;

import CompactStandardLibrary;

export ledger server_root: Bytes<32>;
export ledger nullifiers: Map<Bytes<32>, Boolean>;
export ledger members_joined: Counter;
export ledger admin: Bytes<32>;

constructor(root: Bytes<32>, admin_pk: Bytes<32>) {
  server_root = disclose(root);
  admin = disclose(admin_pk);
  members_joined.increment(0);
}

witness localSecretKey(): Bytes<32>;
witness merkleProof(): Vector<6, Bytes<32>>;
witness merkleDirections(): Vector<6, Boolean>;

export circuit updateRoot(new_root: Bytes<32>): [] {
  assert(disclose(publicKey(localSecretKey())) == admin, "Only admin can update root");
  server_root = disclose(new_root);
}

export circuit claimEntry(): [] {
  const sk = localSecretKey();
  const pk = publicKey(sk);

  // Recompute Merkle root and assert it matches on-chain server_root
  const proof = merkleProof();
  const directions = merkleDirections();
  const calculated_root = computeRootDepth6(pk, proof, directions);
  
  assert(disclose(calculated_root) == server_root, "User is not in the server whitelist");

  // Prevent double-entry
  const nullifier = computeNullifier(sk);
  assert(!nullifiers.member(disclose(nullifier)), "User has already joined the server");
  
  nullifiers.insert(disclose(nullifier), true);
  members_joined.increment(1);
}

export circuit hashNodes(left: Bytes<32>, right: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([left, right]);
}

export circuit computeRootDepth6(leaf: Bytes<32>, proof: Vector<6, Bytes<32>>, directions: Vector<6, Boolean>): Bytes<32> {
  const hash0 = directions[0] ? hashNodes(leaf, proof[0]) : hashNodes(proof[0], leaf);
  const hash1 = directions[1] ? hashNodes(hash0, proof[1]) : hashNodes(proof[1], hash0);
  const hash2 = directions[2] ? hashNodes(hash1, proof[2]) : hashNodes(proof[2], hash1);
  const hash3 = directions[3] ? hashNodes(hash2, proof[3]) : hashNodes(proof[3], hash2);
  const hash4 = directions[4] ? hashNodes(hash3, proof[4]) : hashNodes(proof[4], hash3);
  const hash5 = directions[5] ? hashNodes(hash4, proof[5]) : hashNodes(proof[5], hash4);
  return hash5;
}

export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "server:pk:"), sk]);
}

export circuit computeNullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "server:nullifier:"), sk]);
}
